    <!--
        SAIF AI mark.
        A glass plate carrying a clean "S" prism, with a four-point spark and a small agent
        node - the visual language modern AI apps use for their logo.
        Everything sits inside the 66dp safe zone of the adaptive icon.
    -->

    <!-- Glass plate: gives the mark depth against any wallpaper. -->
    <path
        android:pathData="M34,27 L74,27 Q74,27 74,27 L74,73 Q74,73 74,73 L34,73 Q34,73 34,73 L34,27 Q34,27 34,27 Z"
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.15" />

    <!-- The "S" - upper bowl, diagonal, lower bowl. -->
    <path
        android:pathData="M68,39.5 C66,35 61,32.5 55,32.5 C48.5,32.5 43.5,35.5 41,39.5 C38.5,43.5 41,46.8 46,48.4 L54.5,49.6 C60.5,50.9 63,53.2 63,57.5 C63,62.5 59,65.6 53.5,65.6 C47,65.6 43.2,62.6 41,58.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="8.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Facet highlight along the diagonal of the S. -->
    <path
        android:pathData="M47.5,45.5 L58.5,54.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.28"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />

    <!-- Spark: the "live" detail that marks the agent as active. -->
    <path
        android:pathData="M82,20.5 C84.2,29 84.2,29 92.5,31.2 C84.2,33.4 84.2,33.4 82,41.9 C79.8,33.4 79.8,33.4 71.5,31.2 C79.8,29 79.8,29 82,20.5 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Agent node and its link back to the plate. -->
    <path
        android:pathData="M27,70 m-3.2,0 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0"
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.62" />
    <path
        android:pathData="M27,66.8 L27,52"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.32"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
</vector>
